# ==============================================================================
# FinSolve Technologies Enterprise RAG - .gitignore
# ==============================================================================

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!.frontend/.env.example
*.pem
*.key
*.cert

# ── Python & Bytecode ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ────────────────────────────────────────────────────
venv/
venv*/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Vector Database & Local Embeddings / Models ─────────────────────────────
chroma_db/
*.sqlite
*.sqlite3
*.lock
.cache/
huggingface/
torch_cache/
models/

# ── Node.js & Frontend (React / Vite) ───────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Logs & Temporary Files ──────────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~

# ── Testing & Code Quality ──────────────────────────────────────────────────
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.eslintcache

# ── Operating System & Editors ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDEs ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.agents/
