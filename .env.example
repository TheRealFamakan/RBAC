# Copier ce fichier en .env et remplir les valeurs

# --- Groq API (obtenir sur console.groq.com) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- JWT Secret Key (changer en production) ---
SECRET_KEY=finsolve_super_secret_jwt_key_2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ChromaDB ---
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=finsolve_docs

# --- LLM Config ---
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5

# --- Data Path ---
DATA_PATH=./data
